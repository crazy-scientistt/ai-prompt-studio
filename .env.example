# ─────────────────────────────────────────────────────────────────────────────
# Frontend (Vercel) environment variables
# Project → Settings → Environment Variables, then redeploy.
# VITE_* values are baked into the JS bundle at build time.
# ─────────────────────────────────────────────────────────────────────────────

# Proxy address, baked fallback. Leave unset for local dev (defaults to
# http://localhost:3000). PREFER the server-side PROXY_URL below on hosted
# builds — a VITE_ value ships inside the public bundle, this one does not.
#   VITE_PROXY_URL=https://your-proxy.up.railway.app
VITE_PROXY_URL=

# Server-side proxy address, read at runtime by /api/config (api/config.js).
# Nothing here reaches the browser bundle, and changing it needs no code edit.
# Append ?key=<ADMIN_KEY> when the proxy requires a key:
#   PROXY_URL=https://your-proxy.up.railway.app?key=YOUR_ADMIN_KEY
PROXY_URL=

# PIN that unlocks the in-app admin console (#/admin) on hosted builds.
# Leave unset to hide the admin console from customers entirely.
VITE_ADMIN_PIN=

# ─────────────────────────────────────────────────────────────────────────────
# Proxy container (Railway) environment variables
# ─────────────────────────────────────────────────────────────────────────────

# Public address of the proxy service (its own Railway domain). Used for the
# post-login redirect and to decide whether ADD ACCOUNT needs the code-paste
# flow (public) or can use one-click sign-in (localhost).
#   EXTERNAL_URL=https://your-proxy.up.railway.app

# Require every /v1/* and /api/* call to carry this key (Bearer token or ?key=).
# This is what stops strangers from spending the enrolled Google quota.
#   ADMIN_KEY=<long random string>

# HTTP Basic auth for the whole proxy dashboard / enroll pages — your
# username + password on the Railway URL.
#   DASHBOARD_USER=admin
#   DASHBOARD_PASS=<strong password>

# Pin the impersonated Antigravity client version (normally set by the
# dashboard's "Update now" button, which persists it in /data).
#   ANTIGRAVITY_CLIENT_VERSION=2.13.0

# Content-safety threshold passed upstream.
#   SAFETY_THRESHOLD=BLOCK_NONE
